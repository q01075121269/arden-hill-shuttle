# ==========================================
# Arden Hill Resort Smart Shuttle System
# Environment Variables Configuration
# ==========================================

# 1. Application Version Configuration
NEXT_PUBLIC_APP_VERSION=1.0.0
NEXT_PUBLIC_APP_ENV=production

# 2. Supabase Database & Auth Configuration
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your_anon_key_here

# 3. Supabase Service Role Key (Backend Only - NEVER expose to browser)
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your_service_role_key_here

# 4. Optional Operation Defaults
DEFAULT_SHUTTLE_FARE=5000
DEFAULT_CUTOFF_HOUR=22
DEFAULT_CUTOFF_MINUTE=0
ADMIN_EMERGENCY_PHONE=010-3342-9981
DRIVER_EMERGENCY_PHONE=010-8921-4421
